datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String        @id @default(cuid())
  name               String
  email              String        @unique
  passwordHash       String
  isAdmin            Boolean       @default(false)
  plan               Plan          @default(free)
  status             UserStatus    @default(active)
  forcePasswordReset Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  apiKeys            ApiKey[]
  templates          Template[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]
}

model ApiKey {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  name         String
  keyHash      String        @unique
  prefix       String
  environment  Environment   @default(live)
  status       ApiKeyStatus  @default(ACTIVE)
  permissions  Json          @default("[]")
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  notifications Notification[]
  analytics     ApiAnalytics[]
  @@index([userId])
  @@index([keyHash])
  @@index([status])
}

model Template {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  name        String
  channel     Channel
  subject     String?
  body        String
  variables   Json      @default("[]")
  usageCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([userId])
}

model Notification {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  apiKeyId     String?
  apiKey       ApiKey?            @relation(fields: [apiKeyId], references: [id])
  channel      Channel
  recipient    String
  subject      String?
  body         String
  status       NotificationStatus @default(pending)
  latencyMs    Int?
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  @@index([userId])
  @@index([apiKeyId])
  @@index([createdAt])
  @@index([status])
  @@index([apiKeyId, createdAt])
  @@index([apiKeyId, status])
  @@index([userId, channel])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
}

model ApiAnalytics {
  id                  String   @id @default(cuid())
  apiId               String
  api                 ApiKey   @relation(fields: [apiId], references: [id])
  date                DateTime
  totalNotifications  Int      @default(0)
  successCount        Int      @default(0)
  failureCount        Int      @default(0)
  emailCount          Int      @default(0)
  smsCount            Int      @default(0)
  pushCount           Int      @default(0)
  webhookCount        Int      @default(0)
  avgLatencyMs        Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([apiId, date])
  @@index([apiId, date])
}

enum ApiKeyStatus {
  ACTIVE
  PAUSED
  DELETED
}

enum Plan {
  free
  pro
  enterprise
}

enum UserStatus {
  active
  suspended
}

enum Environment {
  live
  test
}

enum Channel {
  email
  sms
  inapp
  push
  webhook
}

enum NotificationStatus {
  pending
  delivered
  success
  failed
  paused
  blocked
}

model SecurityEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventType String
  ip        String?
  userAgent String?
  endpoint  String?
  status    String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@index([userId])
  @@index([ip])
}

model SecurityAlert {
  id             String   @id @default(cuid())
  type           String
  severity       String
  description    String
  status         String   @default("OPEN")
  riskScore      Float    @default(0)
  correlatedWith String[]
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

model UserBaseline {
  id                 String   @id @default(cuid())
  userId             String   @unique
  avgLoginsPerHour   Float    @default(0)
  avgApiCallsPerHour Float    @default(0)
  sampleCount        Int      @default(0)
  updatedAt          DateTime @updatedAt
}

model IpBaseline {
  id                  String   @id @default(cuid())
  ip                  String   @unique
  avgRequestsPerHour  Float    @default(0)
  sampleCount         Int      @default(0)
  updatedAt           DateTime @updatedAt
}

model BlockedIp {
  id        String    @id @default(cuid())
  ip        String    @unique
  reason    String
  blockedAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([ip])
}

model RevokedSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  reason    String?
  revokedAt DateTime @default(now())

  @@index([tokenHash])
  @@index([userId])
}

model Honeytoken {
  id        String   @id @default(cuid())
  prefix    String   @unique
  label     String
  createdAt DateTime @default(now())
}
